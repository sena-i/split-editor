rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Split Editor — authenticated only
    match /series/{doc=**} {
      allow read, write: if request.auth != null;
    }
    // Kanafuri and other existing collections — preserve original open access
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
